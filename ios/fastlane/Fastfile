# iOS Fastlane Configuration for FinWise
# This file contains automated deployment lanes for TestFlight and App Store

import("Fastfile")

default_platform(:ios)

platform :ios do
  desc "Load ASC API Key information to use in subsequent lanes"
  lane :load_asc_api_key do
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_PRIVATE_KEY"],
      is_key_content_base64: true
    )
  end

  desc "Install certificates and provisioning profiles"
  lane :setup_signing do
    # Install distribution certificate
    install_certificate(
      certificate_path: "ios/certs/distribution.p12",
      certificate_password: ENV["IOS_CERTIFICATE_PASSWORD"],
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: "fastlane"
    )

    # Install provisioning profile
    install_provisioning_profile(
      path: "ios/profiles/FinWise_App_Store.mobileprovision"
    )
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    load_asc_api_key
    setup_signing

    # Increment build number
    increment_build_number(
      build_number: ENV["BUILD_NUMBER"] || latest_testflight_build_number + 1
    )

    # Build the app
    build_app(
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.finwise.app" => "FinWise App Store Distribution"
        }
      },
      clean: true,
      output_directory: "build/ios",
      output_name: "finwise.ipa"
    )

    # Upload to TestFlight
    upload_to_testflight(
      ipa: "build/ios/finwise.ipa",
      skip_submission: true,
      distribute_external: true,
      groups: ["Beta Testers"],
      changelog: ENV["RELEASE_NOTES"] || "Beta release with latest features and improvements",
      beta_app_review_info: {
        contact_email: "support@finwise.app",
        contact_first_name: "FinWise",
        contact_last_name: "Team",
        contact_phone: "+1234567890",
        demo_account_name: "demo@finwise.app",
        demo_account_password: "DemoPass123!",
        notes: "AI-powered expense manager with receipt scanning and smart categorization"
      }
    )

    # Clean up artifacts
    clean_build_artifacts
  end

  desc "Build and submit to App Store Review"
  lane :release do
    load_asc_api_key
    setup_signing

    # Increment build number
    increment_build_number(
      build_number: ENV["BUILD_NUMBER"] || latest_testflight_build_number + 1
    )

    # Build the app
    build_app(
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.finwise.app" => "FinWise App Store Distribution"
        }
      },
      clean: true,
      output_directory: "build/ios",
      output_name: "finwise.ipa"
    )

    # Upload to App Store Connect
    deliver(
      ipa: "build/ios/finwise.ipa",
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_encryption_updated: false,
        export_compliance_uses_encryption: false
      },
      release_notes: ({
        'en-US': ENV["RELEASE_NOTES"] || "Major update with enhanced features and performance improvements"
      }),
      app_review_information: ({
        first_name: "FinWise",
        last_name: "Team",
        email_address: "support@finwise.app",
        phone_number: "+1234567890",
        demo_account_name: "demo@finwise.app",
        demo_account_password: "DemoPass123!",
        notes: "AI-powered expense manager with receipt scanning and smart categorization"
      })
    )

    # Create git tag
    version = get_version_number
    build = get_build_number
    add_git_tag(
      tag: "ios/v#{version}+#{build}",
      message: "iOS Release v#{version}+#{build}"
    )

    push_git_tags

    # Clean up artifacts
    clean_build_artifacts
  end

  desc "Update app metadata in App Store Connect"
  lane :metadata do
    load_asc_api_key

    deliver(
      skip_binary_upload: true,
      skip_screenshots: false,
      screenshots_path: "fastlane/screenshots",
      metadata_path: "fastlane/metadata",
      app_version: ENV["APP_VERSION"],
      force: true
    )
  end

  desc "Take screenshots for App Store"
  lane :screenshots do
    capture_ios_screenshots(
      scheme: "Runner",
      configuration: "Release-Staging",
      devices: [
        "iPhone 14 Pro Max",
        "iPhone 14 Pro",
        "iPhone 14",
        "iPhone SE (3rd generation)",
        "iPad Pro (12.9-inch) (6th generation)"
      ],
      languages: [
        "en-US",
        "es-ES",
        "fr-FR",
        "de-DE"
      ],
      output_directory: "fastlane/screenshots",
      clear_previous_screenshots: true,
      skip_open_summary: true,
      concurrent_simulators: false
    )
  end

  desc "Run tests and generate coverage"
  lane :test do
    run_tests(
      scheme: "Runner",
      devices: ["iPhone 14"],
      code_coverage: true,
      output_directory: "fastlane/test_output",
      output_types: "html,junit",
      fail_build: true
    )
  end

  desc "Deploy to TestFlight (alias for beta)"
  lane :testflight do
    beta
  end

  desc "Deploy to App Store (alias for release)"
  lane :appstore do
    release
  end

  desc "Emergency rollback to previous version"
  lane :rollback do
    load_asc_api_key

    # Get previous version
    previous_version = ENV["ROLLBACK_VERSION"]
    if previous_version.nil?
      UI.error "Please set ROLLBACK_VERSION environment variable"
      next
    end

    # Reject current submission if in review
    reject_version_if_possible

    # Submit previous version
    deliver(
      app_version: previous_version,
      submit_for_review: true,
      automatic_release: false,
      force: true
    )
  end

  desc "Check app status in App Store Connect"
  lane :status do
    load_asc_api_key

    # Get latest build info
    latest_build = latest_testflight_build_number
    UI.message "Latest TestFlight build: #{latest_build}"

    # Check processing builds
    processing_builds = builds(
      app_id: ENV["IOS_APP_ID"]
    ).select { |build| build.processing }

    if processing_builds.empty?
      UI.success "No builds currently processing"
    else
      UI.message "Processing builds: #{processing_builds.map(&:version).join(', ')}"
    end
  end
end
